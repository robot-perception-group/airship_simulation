<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.3667</latitude_deg>
      <longitude_deg>9.105703</longitude_deg>
      <!-- <longitude_deg>8.5500</longitude_deg> -->
      <elevation>450.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <physics type='ode'>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.9</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <!-- <max_step_size>0.00667</max_step_size> -->
      <max_step_size>0.01</max_step_size>
      <!--<real_time_factor>1</real_time_factor>-->
      <!-- <real_time_update_rate>90</real_time_update_rate> -->
      <real_time_update_rate>100</real_time_update_rate>
      <!-- <real_time_update_rate>104.947526</real_time_update_rate> -->
      <!-- <real_time_update_rate>150</real_time_update_rate> -->
      <gravity>0 0 -9.8</gravity>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <sky>
        <time>12.0</time>
        <sunrise>6.0</sunrise>
        <sunset>20.0</sunset>
        <clouds>
          <speed>0.6</speed>
          <direction>0.0</direction>
          <humidity>0.5</humidity>
          <mean_size>0.5</mean_size>
          <ambient>0.8 0.8 0.8 1</ambient>
        </clouds>
      </sky>
    </scene>
    <!-- <include>
      <uri>model://mud_pelt_or_grass_plane</uri> 
    </include> -->
